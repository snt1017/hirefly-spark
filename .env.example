# Browser-safe Supabase configuration (never place service-role credentials here).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Browser-safe PostHog configuration (these are public tokens safe to expose in the client).
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
